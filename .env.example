MONGO_URI=mongodb://mongo:27017/mycar
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
PORT=3000
GEOCODE_BASE_URL=https://nominatim.openstreetmap.org
ADMIN_EMAIL=owner@mycar.com
ADMIN_PASSWORD=change-me-admin
# Push notifications (Firebase Cloud Messaging) — leave both unset to run with
# Socket.IO-only dispatch (no crash, just no background push).
# Local dev: put the downloaded file at ./firebase-service-account.json (gitignored).
FIREBASE_SERVICE_ACCOUNT_PATH=firebase-service-account.json
# Cloud hosts (e.g. Render): paste the entire service-account JSON as one line instead.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
